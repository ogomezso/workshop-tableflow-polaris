# Copy to secrets.env (git-ignored) and fill in. Never commit real values.
export KAFKA_BOOTSTRAP=pkc-xxxxx.westeurope.azure.confluent.cloud:9092
export KAFKA_KEY=
export KAFKA_SECRET=
export SR_URL=https://psrc-xxxxx.westeurope.azure.confluent.cloud
export SR_KEY=
export SR_SECRET=
# Tableflow-scoped API key: confluent api-key create --resource tableflow
export TF_KEY=
export TF_SECRET=

# Generated passwords; create once with: openssl rand -hex 12
export MYSQL_ROOT_PW=
export MYSQL_CDC_PW=
export PG_PW=
export PG_CDC_PW=
export POLARIS_CLIENT_SECRET=    # printed by scripts/01-azure.sh (service principal secret for Polaris -> ADLS)
export POLARIS_ROOT_SECRET=      # openssl rand -hex 16
