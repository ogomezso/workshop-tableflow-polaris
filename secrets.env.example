# Copy to secrets.env (git-ignored) and fill in, or run `make init`. Never commit real values.
export KAFKA_BOOTSTRAP=pkc-xxxxx.eu-west-1.aws.confluent.cloud:9092
export KAFKA_KEY=
export KAFKA_SECRET=
# Public "Endpoint URL" (psrc-...), NOT the private endpoint (...aws.private.confluent.cloud): it does not resolve from your laptop
export SR_URL=https://psrc-xxxxx.eu-west-1.aws.confluent.cloud
export SR_KEY=
export SR_SECRET=
# Tableflow-scoped API key: confluent api-key create --resource tableflow
export TF_KEY=
export TF_SECRET=

# Generated by `make init` (or: openssl rand -hex 12)
export MYSQL_ROOT_PW=
export MYSQL_CDC_PW=
export PG_PW=
export PG_CDC_PW=
export POLARIS_ROOT_SECRET=      # openssl rand -hex 16

# Access key of the IAM user POLARIS_USER, written by scripts/01-aws.sh. Named POLARIS_AWS_* on purpose:
# AWS_ACCESS_KEY_ID would override your own AWS CLI credentials in every shell that sources this file.
export POLARIS_AWS_ACCESS_KEY_ID=
export POLARIS_AWS_SECRET_ACCESS_KEY=
