# Copy to env.sh (git-ignored) and fill in, or just run `make init` (creates env.sh and secrets.env with fixed random values).
# Source it in every shell: source env.sh
# Everything runs in a local kind cluster. The only cloud resources are Confluent Cloud (on AWS) and one S3 bucket.
# The S3 bucket and the Confluent Kafka cluster MUST be in the same AWS region (Tableflow requirement).
export AWS_REGION=eu-west-1
export OWNER_EMAIL=               # optional: added as the owner_email tag on every AWS resource (some orgs require it)
export SUFFIX=changeme            # fixed value set once by `make init`; never use $(...) here, it would change on every source
export BUCKET=tf-polaris-${SUFFIX}                  # globally unique, lowercase
export KIND_CLUSTER=tf-polaris
export TABLEFLOW_ROLE=tableflow-role-${SUFFIX}      # IAM role Confluent assumes to write to the bucket
export POLARIS_ROLE=polaris-reader-${SUFFIX}        # IAM role Polaris assumes to vend read-only credentials
export POLARIS_USER=polaris-kind-${SUFFIX}          # IAM user whose access key lets Polaris (outside AWS) assume POLARIS_ROLE

# Set by `make init` / scripts/01-aws.sh
export AWS_ACCOUNT_ID=
export TABLEFLOW_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNT_ID}:role/${TABLEFLOW_ROLE}
export POLARIS_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNT_ID}:role/${POLARIS_ROLE}

# Confluent (from the CLI, see BUILD_GUIDE.md Part B)
export ENV_ID=
export CLUSTER_ID=
export POOL_ID=
export ORG_ID=
# Written by `make confluent-storage` (AWS provider integration)
export PI_ID=                     # cspi-xxxxx
export CONFLUENT_IAM_ROLE_ARN=
export CONFLUENT_EXTERNAL_ID=
export IRC="https://tableflow.${AWS_REGION}.aws.confluent.cloud/iceberg/catalog/organizations/${ORG_ID}/environments/${ENV_ID}"
