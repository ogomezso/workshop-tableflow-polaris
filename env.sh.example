# Copy to env.sh (git-ignored) and fill in. Source it in every shell: source env.sh
# Only Azure resources: RG, ADLS Gen2 and a service principal for Polaris. Kubernetes runs in kind.
# Names must be globally unique: SA is lowercase alphanumeric, max 24 chars.
export LOC=westeurope
export RG=rg-tf-polaris-demo
export SUFFIX=changeme            # e.g. $(openssl rand -hex 3), keep it fixed once chosen
export SA=sttfpolaris${SUFFIX}
export CONTAINER=tableflow
export SP_NAME=sp-polaris-${SUFFIX}
export KIND_CLUSTER=tf-polaris

# Filled by scripts/01-azure.sh
export TENANT_ID=
export SUB_ID=
export SA_ID=
export POLARIS_CLIENT_ID=

# Confluent (from the CLI, see BUILD_GUIDE.md Part B)
export ENV_ID=
export CLUSTER_ID=
export POOL_ID=
export PI_ID=                     # cspi-xxxxx, Azure provider integration
export ORG_ID=
export CONFLUENT_APP_ID=          # Entra app ID shown by the provider integration
export IRC="https://tableflow.${LOC}.azure.confluent.cloud/iceberg/catalog/organizations/${ORG_ID}/environments/${ENV_ID}"

# Database endpoints: ngrok TCP tunnels to the kind NodePorts. Filled from `make tunnels` output (change on every ngrok restart)
export MYSQL_HOST=
export MYSQL_PORT=
export PG_HOST=
export PG_PORT=
